<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="200" d:DesignHeight="50"
             x:Class="NightmareEditor.Controls.EditorFile">
    <UserControl.Resources>
        <FontFamily x:Key="JetBrains Mono">avares://Nightmare Editor AUI/Assets/fonts#JetBrains Mono</FontFamily>
    </UserControl.Resources>
    <Grid Name="Grid" Height="20" Cursor="Hand">
        <Border Name="Border" BorderBrush="#424242" BorderThickness="2" PointerPressed="Press" PointerReleased="Release" PointerExited="EndHover">
            <TextBlock Name="TextBlock" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                       Padding="2,0" Foreground="#f2f2f2" Background="#202020" 
                       FontSize="12" FontFamily="{StaticResource 'JetBrains Mono'}"
                       Text="Testing Testing 1 2 1 2"/>
        </Border>
        <ProgressBar Name="ProgressBar" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsVisible="False" Background="#404080F0" Foreground="#4080F0" Minimum="0" Maximum="1" Value="0"/>
    </Grid>
</UserControl>
